# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# Plain KEY=value lines (shell syntax; quote values with spaces). Read by every agent in .claude/agents/,
# by docker/*.sh and swarm.mk. A variable already set in the environment (Railway variable, CI, shell)
# overrides the value here. This file is the ONLY place repo-specific swarm behaviour is configured.

PROJECT=my-ip                          # short name (git identities, devcontainer title)
GH_REPO=markrthomas/my-ip              # owner/name: where the batch publishes results (metrics-data branch)
DUT_TOP=my_ip_top                      # top-level RTL module

RTL_DIR=rtl                            # DUT source dir: agents never edit it without the owner (mutations only in worktrees)
TB_DIR=dv                              # testbench root (dv/, verification/, test/, ...)

DV_ENVS="iverilog vlt cocotb"          # each is a root `make <env>` target; Swarm A runs one dv-env-tester per entry
GATE_TARGET=regress                    # fast gate: must pass before any swarm push
CI_TARGET=ci                           # full local mirror of CI: what the Railway batch / `make batch` runs
CROSSCHECK_TARGET=                     # target comparing every env against the golden model (empty = none)
INFRA_TARGETS="formal"                 # non-sim flows infra-agent runs (formal, lint-extra, waves, ...)
HEAVY_TARGETS="vlt uvm formal ci"      # memory-hungry: agents run them as `make heavy T=<t>`, one at a time

MUTATION_FILE=rtl/my_ip_datapath.sv    # default file the mutation-check skill mutates
MUTATION_HINT="flip one data bit on the last beat"   # default mutation (small, deterministic, scoreboard-visible)

RR_DIR=dv/random                       # random-regression home: runs/, corpus.json, board/ (status board)
RR_STATUS=bootstrap                    # present = make rr-build/rr/rr-triage/rr-replay exist; bootstrap = Swarm B builds them first

METRICS=no                             # yes = repo has metrics/ (make metrics + dashboard); the batch publishes them
METRICS_FLOWS=                         # METRICS=yes only: comma list of flows the batch times (default: CI_TARGET)

# --- optional ---------------------------------------------------------------------------------------------------
MAKE_OVERRIDES=                        # extra make args for bundled tools in the image (e.g. VERILATOR=/opt/... UVM_HOME=/opt/...)
MIN_MEM_MB=                            # batch memory floor; the entrypoint fails fast below it (SKIP_MEM_CHECK=1 bypasses)
SWARM_MODEL_PROVIDER=anthropic         # anthropic | kimi (kimi sends repo contents to Moonshot; see docker/provider-env.sh)
SWARM_MAX_PARALLEL=                    # max sub-agents the swarm-manager runs at once (memory-bound builds); empty = all
POST_BATCH=                            # command after the batch, additive (e.g. "make metrics dashboard")
KIT_KEEP=                              # repo-owned paths sync.sh never overwrites, e.g. "docker/entrypoint.sh railway.toml"
