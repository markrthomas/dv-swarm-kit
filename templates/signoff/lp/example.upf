# example.upf — IEEE-1801 (UPF) low-power TEMPLATE for a design-track DV repo.
#
# Tapeout-readiness program T3 (workspace DESIGN_READINESS.md). A clean two-domain
# pattern (always-on control + one switchable datapath domain) with isolation,
# retention and a header power switch. Copy into the repo's syn/lp/, rename, and map
# `-elements`/control signals to the real hierarchy. `upf_lint.tcl` checks consistency;
# the power-aware run (VCS -upf) + RTL<->UPF LEC are needs-license (see LP_PLAN.md).
#
# Canonical origin: ucie_rdi_to_pcie6_pipe7 (test/upf) + IP-axi-to-2apbs (syn/lp).

set_design_top TOP_MODULE

# --- domains: PD_AON always-on control, PD_SW switchable datapath ---
create_power_domain PD_AON -elements {.}
create_power_domain PD_SW  -elements {INST_A INST_B}

# --- supply network (switched rail for PD_SW) ---
create_supply_port  VDD    -domain PD_AON
create_supply_port  VSS    -domain PD_AON
create_supply_net   VDD    -domain PD_AON
create_supply_net   VSS    -domain PD_AON
create_supply_net   VDD_SW -domain PD_SW
set_domain_supply_net PD_AON -primary_power_net VDD    -primary_ground_net VSS
set_domain_supply_net PD_SW  -primary_power_net VDD_SW -primary_ground_net VSS

# --- header switch VDD -> VDD_SW ---
create_power_switch sw_hdr \
    -domain        PD_SW \
    -input_supply_port  {vin  VDD} \
    -output_supply_port {vout VDD_SW} \
    -control_port  {sw_en pmu_pwr_en} \
    -on_state      {on vin {sw_en}} \
    -off_state     {off {!sw_en}}

# --- isolation: clamp PD_SW outputs into PD_AON while off ---
set_isolation sw_iso -domain PD_SW \
    -isolation_power_net VDD -isolation_ground_net VSS \
    -clamp_value 0 -applies_to outputs
set_isolation_control sw_iso -domain PD_SW \
    -isolation_signal pmu_iso_en -isolation_sense high -location parent

# --- retention: keep PD_SW state across a power cycle ---
set_retention sw_ret -domain PD_SW \
    -retention_power_net VDD -retention_ground_net VSS
set_retention_control sw_ret -domain PD_SW \
    -save_signal {pmu_save high} -restore_signal {pmu_restore high}

# --- power states ---
create_pst pst -supplies {VDD VDD_SW}
add_pst_state P0_run     -pst pst -state {ON  ON}
add_pst_state P1_iso     -pst pst -state {ON  ON}
add_pst_state P2_shutoff -pst pst -state {ON  OFF}
